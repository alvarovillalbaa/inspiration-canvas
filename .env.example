# Optional single-user local persistence. Leave false for a temporary browser canvas.
LOCAL_PERSISTENCE_ENABLED=false
DATABASE_URL=postgresql://localhost:5432/inspiration_canvas
STORAGE_DRIVER=local
UPLOAD_DIR=.data/uploads
ENABLE_AI=false
ENABLE_EVE_DEV=false

# Hosted Supabase ownership takes precedence over the local mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_MEDIA_BUCKET=inspiration-media

# Optional Vercel storage and AI credentials, supplied by the operator.
BLOB_READ_WRITE_TOKEN=
AI_GATEWAY_API_KEY=
